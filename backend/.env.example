# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection (local dev)
DATABASE_URL=postgresql://sagarmala:sagarmala@localhost:5432/sagarmala

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated list of allowed frontend origins for local dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
